<?xml version="1.0" encoding="utf-8"?>
<!-- Prijenos na novi telefon uključuje podatke; sigurnosna kopija u oblak je isključena. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
