<?xml version="1.0" encoding="utf-8"?>
<!-- Android sigurnosna kopija (Google račun) i prijenos uređaja uključuju podatke aplikacije. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
